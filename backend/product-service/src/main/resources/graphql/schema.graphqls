"""
@key(fields: "id") makes this a federation ENTITY: other subgraphs
(order-service) can reference a Product by id alone (a "stub"/
"representation") without knowing any of its other fields, and Apollo
Router will call this subgraph's entity resolver to fill in whatever
fields the original query actually asked for. This is federation's own
built-in answer to N+1 — Router batches every stub reference collected
across a response into ONE _entities call per subgraph, the same shape
of problem our own DataLoader (see order-service/ProductBatchLoader)
solves manually. Both mechanisms are kept in this project side by side —
see backend/README-FEDERATION.md for why.
"""
type Product @key(fields: "id") {
    id: ID!
    sku: String!
    name: String!
    description: String
    priceCents: Int!
    currency: String!
    createdBy: String!
    createdAt: String!
    updatedAt: String!
}

input CreateProductInput {
    sku: String!
    name: String!
    description: String
    priceCents: Int!
    currency: String = "USD"
}

input UpdateProductInput {
    name: String
    description: String
    priceCents: Int
}

type Query {
    "Public read — requires product:read role"
    products(page: Int = 0, size: Int = 20): [Product!]!
    product(id: ID!): Product
    "Batch lookup used internally by order-service's DataLoader to avoid N+1"
    productsByIds(ids: [ID!]!): [Product!]!
}

type Mutation {
    "Requires product:write role"
    createProduct(input: CreateProductInput!): Product!
    "Requires product:write role"
    updateProduct(id: ID!, input: UpdateProductInput!): Product!
    "Requires admin role"
    deleteProduct(id: ID!): Boolean!
}
