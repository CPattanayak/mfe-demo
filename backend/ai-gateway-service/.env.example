# Copy to .env (gitignored — never commit the real file).
#
# Get an OpenRouter key at https://openrouter.ai/keys — this is a real
# account/API key requirement, not something any file in this repo can
# generate for you. Powers the LangGraph agent's reasoning (app/agent/)
# — the only thing in this service that touches an LLM at all.
OPENROUTER_API_KEY=

# Defaults below match this project's existing local dev setup — only
# override if actually running somewhere those don't apply.
KEYCLOAK_ISSUER=http://localhost:8080/realms/microfrontend-demo
KEYCLOAK_INTERNAL_URL=http://keycloak:8080/realms/microfrontend-demo
KEYCLOAK_CLIENT_ID=web-app
MCP_SERVER_URL=http://apollo-mcp-server:8000/mcp
OPENROUTER_MODEL=openai/gpt-4o-mini
