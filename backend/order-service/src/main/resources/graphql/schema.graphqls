"""
@key(fields: "id") makes Order a federation ENTITY, resolvable by Router
across subgraph boundaries — see FederationConfig.java. Independent of
OrderItem.product below, which is unrelated to federation entirely.
"""
type Order @key(fields: "id") {
    id: ID!
    customerId: String!
    status: String!
    items: [OrderItem!]!
    createdAt: String!
    updatedAt: String!
}

type OrderItem {
    id: ID!
    productId: ID!
    quantity: Int!
    unitPriceCents: Int!
    "Resolved via a batched DataLoader call to product-service — see ProductDataLoader"
    product: OrderProductSummary
}

"""
Deliberately NOT named "Product" and deliberately NOT a federation
extension of product-service's real Product entity. This is order-
service's own local mirror type, populated by its existing DataLoader/
WebClient call to product-service's productsByIds query — a completely
different, already-working mechanism from federation's @key/_entities.
Naming it "Product" would collide with product-service's federated
Product type at Apollo Router's schema COMPOSITION step (two subgraphs
can't both declare an un-extended type with the same name). Converting
OrderItem.product to true cross-subgraph entity resolution instead of
this DataLoader is a valid future step — not done here, to keep the
existing, working DataLoader mechanism (one of this project's original
requirements) intact.
"""
type OrderProductSummary {
    id: ID!
    sku: String!
    name: String!
    priceCents: Int!
    currency: String!
}

input CreateOrderItemInput {
    productId: ID!
    quantity: Int!
}

input CreateOrderInput {
    customerId: String!
    items: [CreateOrderItemInput!]!
}

enum OrderSortField {
    CREATED_AT
    UPDATED_AT
    STATUS
    CUSTOMER_ID
}

enum SortDirection {
    ASC
    DESC
}

type Query {
    "Requires order:read"
    orders(
        page: Int = 0
        size: Int = 20
        sortField: OrderSortField = CREATED_AT
        sortDirection: SortDirection = DESC
    ): [Order!]!
    "Requires order:read"
    order(id: ID!): Order
    """
    Requires order:read. Fetches ONE order item's full details (including
    the full nested Product breakdown) on demand. Exists so list views can
    request a lightweight item shape (id, quantity, product name only) and
    defer the full detail fetch until a specific item is actually opened —
    see OrderItemDetailsDialog.jsx.
    """
    orderItem(id: ID!): OrderItem
}

type Mutation {
    "Requires order:write"
    createOrder(input: CreateOrderInput!): Order!
    "Requires order:write"
    updateOrderStatus(id: ID!, status: String!): Order!
}
